# Copy to .env (gitignored). Leave GOOGLE_CLOUD_PROJECT empty for sample mode.
# See docs/vertex-setup.md.

GOOGLE_CLOUD_PROJECT=
# Checked 2026-10-20: gemini-3.8-live works in us-central1, not in asia-south1 or global.
# If you change the region, update the region line in the consent text (web/index.html).
GOOGLE_CLOUD_LOCATION=us-central1
CVS_LIVE_MODEL=gemini-3.8-live
# CVS_VOICE=Kore

# Only if you use a service-account key instead of `gcloud auth application-default login`.
# Keep the key file outside this folder.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\outside\repo\key.json

# Cost controls (seconds)
# CVS_LIVE_MAX_SECONDS=600
# CVS_LIVE_IDLE_SECONDS=60

# Force sample mode even with a project set
# CVS_SAMPLE_MODE=1

# Print every tool call to the server console. Contains CV data: local debugging only.
# CVS_LOG_TOOLS=1

# Drafting model (text). Newer Gemini text models are only served from "global".
# Checked 2026-10-20: gemini-3.8-flash and gemini-3.1-pro-preview work in global, not in us-central1.
CVS_DRAFT_MODEL=gemini-3.8-flash
CVS_DRAFT_LOCATION=global
